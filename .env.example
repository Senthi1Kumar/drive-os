# DriveOS service keys. Copy this file to .env and fill in the keys you have.
# Every key is optional: without one, the matching feature falls back to on-device behaviour.
# Never commit the real .env.

# Mapbox: live map, traffic-aware routing and real nearby places (https://account.mapbox.com/access-tokens)
DRIVEOS_MAPBOX__TOKEN=

# OpenRouter: the Nova conversational agent (https://openrouter.ai/keys).
# Without it, Nova uses the on-device command parser only.
OPENROUTER_API_KEY=

# Exa: web search for live facts such as opening hours, reviews and charger status (https://dashboard.exa.ai/api-keys).
# Queries are scrubbed on the device; your name and GPS position are never sent.
EXA_API_KEY=
