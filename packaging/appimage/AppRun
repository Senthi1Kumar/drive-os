#!/usr/bin/env bash
# DriveOS AppImage entry point. Never reads configuration or secrets from inside the image.
#   AppRun                 back-end + LVGL front-end, supervised
#   AppRun --server-only   back-end only (headless; WS 127.0.0.1:8790/v1/ui)
#   AppRun --hmi-only      front-end only (expects a back-end already listening)
#   AppRun --selftest      import check, WS hello, headless screenshots of 3 screens; exit 0 = healthy
set -u
HERE="$(dirname "$(readlink -f "${0}")")"
PY="$HERE/usr/python/bin/python"
HMI="$HERE/usr/bin/driveos-hmi"
FIXTURES="$HERE/usr/share/drive-os/fixtures"
PORT="${DRIVEOS_UI_PORT:-8790}"

export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export DRIVEOS_PARAKEET_LIB="$HERE/usr/lib/driveos/parakeet/libparakeet.so"
export DRIVEOS_VOICE__SILERO_MODEL="$HERE/usr/share/drive-os/models/silero_vad.onnx"
export DRIVEOS_VOICE__SMART_TURN_MODEL="$HERE/usr/share/drive-os/models/smart-turn-v3.2-cpu.onnx"
export DRIVEOS_IMAGES__GENERATED_DIR="$HERE/usr/share/drive-os/food"
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# The bundle is CPU-only and torch-free. To use packages from the host Python, set
# DRIVEOS_SYSTEM_SITE=<host site-packages>;
# a .pth hook in the bundle's site-packages appends it AFTER the bundled packages (so the bundled numpy wins).

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/drive-os"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/drive-os"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/drive-os"
mkdir -p "$CONF" "$DATA"/{models,enroll,ledger,driveauth-store} "$STATE"/{logs,update}
chmod 700 "$CONF" "$DATA/enroll" "$DATA/driveauth-store" 2>/dev/null || true
LOG="$STATE/logs"
export DRIVEOS_DATA_DIR="$DATA" XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
[ -f "$CONF/config.toml" ] && export DRIVEOS_CONFIG="${DRIVEOS_CONFIG:-$CONF/config.toml}"
[ -z "${DRIVEOS_CONFIG:-}" ] && [ -f "$HOME/.config/driveos/config.toml" ] && export DRIVEOS_CONFIG="$HOME/.config/driveos/config.toml"
# secrets: only from the user's config dir (mode 0600 recommended), never from the image
if [ -f "$CONF/.env" ]; then
  export DRIVEOS_ENV_FILE="$CONF/.env"
  set -a; . "$CONF/.env"; set +a
fi

MODE=run
for a in "$@"; do
  case "$a" in
    --selftest) MODE=selftest ;;
    --server-only) MODE=server ;;
    --hmi-only) MODE=hmi ;;
    --version) "$PY" -c 'import driveos; print("DriveOS", driveos.__version__)'; "$HMI" --version; exit 0 ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
  esac
done

log() { printf '[drive-os %s] %s\n' "$(date +%T)" "$*" >&2; }

restore_audio_levels() {
  bash "$HERE/usr/share/drive-os/scripts/set_xvf3800_levels.sh" || true
}

install_desktop_entry() {
  local apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications" icons="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps"
  local target="${APPIMAGE:-}"; [ -n "$target" ] || return 0
  [ -f "$apps/drive-os.desktop" ] && grep -qF "Exec=$target" "$apps/drive-os.desktop" 2>/dev/null && return 0
  mkdir -p "$apps" "$icons"
  cp "$HERE/usr/share/icons/hicolor/256x256/apps/drive-os.png" "$icons/drive-os.png" 2>/dev/null || true
  sed -e "s|^Exec=.*|Exec=\"$target\"|" -e "s|^Icon=.*|Icon=drive-os|" "$HERE/drive-os.desktop" > "$apps/drive-os.desktop"
  command -v update-desktop-database >/dev/null && update-desktop-database "$apps" 2>/dev/null || true
}

setup_display() {
  if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then export XDG_RUNTIME_DIR="/run/user/$(id -u)"; fi
  if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    local s; s=$(ls "$XDG_RUNTIME_DIR" 2>/dev/null | grep -E '^wayland-[0-9]+$' | head -1)
    [ -n "$s" ] && export WAYLAND_DISPLAY="$s"
  fi
  if [ -n "${WAYLAND_DISPLAY:-}" ]; then export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-wayland}"; fi
}

wait_hello() {  # wait_hello SECONDS -> 0 when /v1/ui answers with a hello frame
  "$PY" - "$PORT" "$1" <<'PY'
import asyncio, json, sys, time
from websockets.asyncio.client import connect
port, budget = int(sys.argv[1]), float(sys.argv[2])
async def once():
    async with connect(f"ws://127.0.0.1:{port}/v1/ui", open_timeout=2) as ws:
        m = json.loads(await asyncio.wait_for(ws.recv(), 3))
        return m.get("type") == "hello"
end = time.time() + budget
while time.time() < end:
    try:
        if asyncio.run(once()): sys.exit(0)
    except Exception:
        time.sleep(0.5)
sys.exit(1)
PY
}

selftest() {
  local rc=0 tmp; tmp="$(mktemp -d)"
  log "selftest: back-end import"
  "$PY" -c 'import driveos, driveos.server.runner, driveauth, websockets, numpy; import ptts; import sys; assert "PySide6" not in sys.modules; print("ok", driveos.__version__)' || rc=1
  local f
  for f in "$DRIVEOS_PARAKEET_LIB" "$DRIVEOS_VOICE__SILERO_MODEL" "$DRIVEOS_VOICE__SMART_TURN_MODEL" \
           "$DRIVEOS_IMAGES__GENERATED_DIR/LICENSE.md" "$HERE/usr/lib/libmaplibre-native-c.so" \
           "$HERE/usr/share/drive-os/scripts/set_xvf3800_levels.sh"; do
    if [ -s "$f" ]; then log "resource OK: ${f#$HERE/}"; else log "resource MISSING: ${f#$HERE/}"; rc=1; fi
  done
  "$PY" - <<'PY' || rc=1
import ctypes
import os
import onnxruntime as ort
ctypes.CDLL(os.environ["DRIVEOS_PARAKEET_LIB"])
for key in ("DRIVEOS_VOICE__SILERO_MODEL", "DRIVEOS_VOICE__SMART_TURN_MODEL"):
    ort.InferenceSession(os.environ[key], providers=["CPUExecutionProvider"])
print("native speech libraries and ONNX models OK")
PY
  log "selftest: back-end WS hello"
  DRIVEOS_UI_PORT="$PORT" "$PY" -m driveos.server --no-voice --port "$PORT" >"$tmp/server.log" 2>&1 & local spid=$!
  if wait_hello 40; then log "hello OK"; else log "hello FAILED"; tail -20 "$tmp/server.log" >&2; rc=1; fi
  kill "$spid" 2>/dev/null; wait "$spid" 2>/dev/null
  log "selftest: HMI headless screenshots"
  local pair
  for pair in home:home agent_idle:agent about_update:about; do
    local fx="${pair%%:*}" sc="${pair##*:}"
    if SDL_VIDEODRIVER=dummy "$HMI" --fixture "$FIXTURES/$fx.json" --screen "$sc" --screenshot "$tmp/$sc.png" >/dev/null 2>&1 && [ -s "$tmp/$sc.png" ]; then
      log "screenshot $sc OK ($(stat -c %s "$tmp/$sc.png") bytes)"
    else log "screenshot $sc FAILED"; rc=1; fi
  done
  rm -rf "$tmp"
  [ $rc -eq 0 ] && log "SELFTEST PASS" || log "SELFTEST FAIL"
  return $rc
}

SERVER_PID=""; HMI_PID=""
cleanup() {
  trap - EXIT INT TERM
  [ -n "$HMI_PID" ] && kill "$HMI_PID" 2>/dev/null
  local children=""
  if [ -n "$SERVER_PID" ] && [ -r "/proc/$SERVER_PID/task/$SERVER_PID/children" ]; then
    read -r children < "/proc/$SERVER_PID/task/$SERVER_PID/children" || true
  fi
  [ -n "$SERVER_PID" ] && kill "$SERVER_PID" 2>/dev/null
  [ -n "$children" ] && kill $children 2>/dev/null
  wait 2>/dev/null
}

supervise_server() {  # restart the back-end with exponential backoff; reset after a 60 s healthy run
  local delay=1 t0
  while true; do
    t0=$(date +%s)
    "$PY" -m driveos.server "$@" >>"$LOG/server.log" 2>&1
    local rc=$? up=$(( $(date +%s) - t0 ))
    log "back-end exited rc=$rc after ${up}s; restart in ${delay}s"
    [ "$up" -ge 60 ] && delay=1
    sleep "$delay"; [ "$delay" -lt 30 ] && delay=$(( delay * 2 ))
  done
}

case "$MODE" in
  selftest) setup_display; selftest; exit $? ;;
  server)   restore_audio_levels; trap cleanup EXIT INT TERM; supervise_server --port "$PORT" & SERVER_PID=$!; wait "$SERVER_PID"; exit $? ;;
  hmi)      restore_audio_levels; setup_display; exec "$HMI" --url "ws://127.0.0.1:$PORT/v1/ui" ;;
esac

install_desktop_entry
setup_display
restore_audio_levels
if [ ! -d "$DATA/models" ] || [ -z "$(ls -A "$DATA/models" 2>/dev/null)" ]; then
  log "first run: fetching models (network required)"
  "$PY" -m driveos fetch-models >>"$LOG/fetch-models.log" 2>&1 || log "fetch-models failed; see $LOG/fetch-models.log"
fi
trap cleanup EXIT INT TERM
supervise_server --port "$PORT" & SERVER_PID=$!
wait_hello 60 || log "back-end not answering yet; starting HMI anyway (it shows reconnecting)"
"$HMI" --url "ws://127.0.0.1:$PORT/v1/ui" >>"$LOG/hmi.log" 2>&1 & HMI_PID=$!
wait "$HMI_PID"; rc=$?
HMI_PID=""
exit $rc
